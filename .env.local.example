# Optional local overrides for zoea-web-ui

# Zoea HTTP API base URL (leave empty to use same-origin / Vite proxy)
# VITE_ZOEA_BASE_URL=http://localhost:14004

# Zoea WebSocket base URL (leave empty to derive from HTTP base URL / page origin)
# VITE_ZOEA_WS_BASE_URL=ws://localhost:14004

# Vite dev proxy target
VITE_ZOEA_DEV_PROXY_TARGET=http://localhost:14004

# Default session identity
VITE_ZOEA_USER_ID=web-user
# VITE_ZOEA_PROJECT_ID=my-project
